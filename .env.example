# Copy this file to .env and fill in real values. NEVER commit the real .env.

# --- Database ---------------------------------------------------------------
DB_USER=nuauto
DB_PASS=change-me
DB_HOST=localhost
DB_NAME=nuautorent

# --- Auth -------------------------------------------------------------------
# REQUIRED. The app refuses to start without this. Generate a strong random
# value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Runtime (local dev via `python server.py`) -----------------------------
# Leave these secure-by-default. Only set FLASK_DEBUG=true on a trusted local
# machine; never in production (the Werkzeug debugger allows code execution).
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# --- Optional ---------------------------------------------------------------
# Set to "true" ONLY for initial local setup to allow POST /auth/register.
ALLOW_OPEN_REGISTRATION=false
# Point at Redis for multi-process rate limiting, e.g. redis://localhost:6379
# RATELIMIT_STORAGE_URI=memory://
